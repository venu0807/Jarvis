{
    "title": "System Metrics",
    "uid": "metrics-dashboard-01",
    "refresh": "1m",
    "panels": [
        {
            "type": "timeseries",
            "title": "Activity Over Time by Category",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 10
            },
            "datasource": {
                "type": "postgres",
                "uid": "postgres_metrics_uid"
            },
            "targets": [
                {
                    "rawSql": "SELECT timestamp::timestamp as time, count as value, category as metric FROM metrics ORDER BY timestamp ASC",
                    "format": "time_series",
                    "refId": "A"
                }
            ]
        }
    ]
}