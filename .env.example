# ═══════════════════════════════════════════════════════════
# JARVIS — Centralized Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to version control.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your real credentials
# ═══════════════════════════════════════════════════════════

# ── Personal Info ──────────────────────────────────────────
USER_FULL_NAME="Your Full Name"
USER_FULL_NAME_UPPER="YOUR NAME IN CAPS"
USER_EMAIL="you@example.com"
GMAIL_ADDRESS="your.email@gmail.com"
USER_PHONE="+91XXXXXXXXXX"
USER_LOCATION="City, Country"
USER_LINKEDIN_URL="https://linkedin.com/in/your-profile"
USER_GITHUB_URL="https://github.com/your-username"
USER_PORTFOLIO_URL="https://your-portfolio.com"
USER_UNIVERSITY="Your University Name"
USER_UNDERGRAD_UNIVERSITY="Your Undergrad University Name"
USER_PROJECT_1_URL="https://github.com/your-username/project"
USER_PROJECT_1_NAME="Your Project Name"
USER_PROJECT_1_ROLE="Your Role"

# ── Job Automation Portals ────────────────────────────────
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
INTERNSHALA_EMAIL=
INTERNSHALA_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=
FOUNDIT_EMAIL=
FOUNDIT_PASSWORD=
CUTSHORT_EMAIL=
CUTSHORT_PASSWORD=
FRESHERSWORLD_EMAIL=
FRESHERSWORLD_PASSWORD=
WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=

# ── Email Notifications ───────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFY_EMAIL=
FALLBACK_EMAIL=

# ── Resume ────────────────────────────────────────────────
RESUME_PATH=
RESUME_PDF_PATH=

# ── LinkedIn Outreach ─────────────────────────────────────
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
APOLLO_API_KEY=
MAX_POSTS_PER_ROLE="8"
DAILY_PERSONAL_CAP="15"
PER_ROLE_CAP="2"
DAILY_FALLBACK_CAP="30"

# ── Pinterest ─────────────────────────────────────────────
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_EMAIL=
PINTEREST_PASSWORD=
AMAZON_AFFILIATE_TAG="studentdeals0a-20"
AMAZON_TAG="studentdeals0a-20"
SHAREASALE_AFFILIATE_ID=
IMPACT_AFFILIATE_ID=
CJ_PID=
AWIN_AFFILIATE_ID=
RAKUTEN_AFFILIATE_ID=
CLICKBANK_AFFILIATE_ID=

# ── Interview Scheduler Bot ───────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Image Generation ──────────────────────────────────────
IDEOGRAM_API_KEY=
NVIDIA_API_KEY=

# ── LLM / Policy ──────────────────────────────────────────
# Set to "1" to allow cloud-based LLM calls (bypasses local-only policy)
JARVIS_ALLOW_CLOUD="0"
# Ollama model to use for local inference
OLLAMA_MODEL="phi4-mini:latest"
# Comma-separated fallback chain (used when composer needs cloud models)
OLLAMA_FALLBACK_CHAIN=""

# ── Pipeline Settings ─────────────────────────────────────
DAILY_LIMIT="15"
HEADLESS="true"
