# ── Unified Root .gitignore ───────────────────────────────────────────
# Centralizes all ignore patterns from automations/ subdirectories.
# Individual .gitignore files in subdirectories are retained for
# backward compatibility but this file covers everything.
#
# Generated: 2026-06-18

# ==============================================================================
# SECRETS & CREDENTIALS — never commit these
# ==============================================================================
.env
credentials.json
token.json

# ==============================================================================
# BROWSER SESSIONS & COOKIES — contains login state
# ==============================================================================
.sessions/
.playwright/
playwright_data/
playwright_profile/

# ==============================================================================
# PYTHON CACHE
# ==============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class

# ==============================================================================
# VIRTUAL ENVIRONMENTS
# ==============================================================================
venv/
.venv/
env/
.env/
.env_venv/
interview_bot/

# ==============================================================================
# GENERATED OUTPUTS
# ==============================================================================
output/
prep_sheets/
resume_extracted.txt
# NOTE: *.md removed 2026-08-01 — product docs (README, SERVICE_OFFERING) must be versioned
*.pdf

# ==============================================================================
# DEBUG & TEMP FILES
# ==============================================================================
*.log
indeed_debug.png
debug_pin_builder.png
debug_page.html
.stale

# ==============================================================================
# EDITOR / OS SPECIFIC
# ==============================================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ==============================================================================
# JARVIS / OPENCLAW INTERNALS
# ==============================================================================
.jarvis/
.openclaw/

# ==============================================================================
# WINDOWS RESERVED FILENAMES — can't exist on disk, crash git add
# ==============================================================================
nul

# ==============================================================================
# SCRATCH / SCRIPTS TEMP
# ==============================================================================
scratch/
*.bak
*.pre-reauth
wd_browser/
*.exe
brain/openhuman/



# Secrets
.env*
*.pem
*.key
secret.yaml

# ==============================================================================
# PURGED FROM HISTORY (2026-08-04) - Large files and broken gitlinks
# ==============================================================================
automations/pinterest/C:\Users\Venu\AppData\Local/
automations/pinterest/obscura
automations/pinterest/obscura-worker
backups/openclaw-workspace-20260616.tar.gz
backups/20260614-182854/openclaw.json
automations/ecommerce/affiliate-store/
automations/linkedin-outreach/sent_tracker.db

# ==============================================================================
# RUNTIME STATE — regenerated every run, never commit
# ==============================================================================
logs/.state_*
logs/alerts.json
automations/inbox-monitor/processed_emails.json
automations/ghost-networker/.seen_events.json
automations/pinterest/trending_cache.json
automations/pinterest/debug_upload.html
automations/pinterest/failed_publish.png
.claude-flow/
automations/micro-learning/daily_lesson.md

# Additional Runtime & Session Ignores
*.lock
*.log*
*.out
*.db-wal
*.db-shm
.sessions/
automations/job-automation/.sessions/
automations/interview_scheduler_prep_bot/processed_emails.json
logs/
automations/logs/
automations/dashboard-nextjs/.next/
automations/dashboard-nextjs/node_modules/
grafana/plugins/
