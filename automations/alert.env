# JARVIS Alert Configuration

# Email (SMTP) - requires Gmail App Password
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=pvgreddy3@gmail.com
# EMAIL_PASSWORD=your-app-password-here
# EMAIL_FROM_ADDR=pvgreddy3@gmail.com
# EMAIL_TO_ADDRS=pvgreddy3@gmail.com

# ntfy.sh (works without credentials) - PRIMARY channel
NTFY_ENABLED=true
NTFY_TOPIC=jarvis-alerts
NTFY_SERVER=https://ntfy.sh

# Webhook (optional) - DISABLED
# WEBHOOK_URL=https://your-webhook-url.com/alert

# NOTE: For Gmail, EMAIL_PASSWORD must be an App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
# Email disabled until App Password is configured