PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_BOARD_ID=your_pinterest_board_id_here

# Optional: auto-login credentials (used only when browser session is missing)
# Session is persistent by default (saved to %LOCALAPPDATA%\PinterestBot),
# so you only need these as a fallback if cookies get cleared.
PINTEREST_EMAIL=your_email_here
PINTEREST_PASSWORD=your_password_here

# Your Amazon Associates tag (earn commission on every sale)
AMAZON_AFFILIATE_TAG=venu080d-21
